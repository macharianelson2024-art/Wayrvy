SECRET_KEY=
DEBUG=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=



# ---------- API BASE ----------
VITE_API_URL=

# ---------- M-PESA / DARAJA ----------
# Switch to "production" when you go live. Right now: "sandbox".
VITE_DARAJA_ENV=

# Sandbox credentials (from https://developer.safaricom.co.ke)
# These are used by the BACKEND — I've included them in the .env file for
# documentation, but they're read by Django's settings, not by Vite.
# Never commit real credentials; keep this file gitignored.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=
DARAJA_CALLBACK_URL=
DARAJA_STK_PUSH_URL=
DARAJA_OAUTH_URL=

# ---------- FRONTEND -------------
# This is what the deposit/withdraw modals call.
# In dev with Vite proxy: "/api" (same-origin, cookies work).
# In production with a reverse proxy: "/api".
# If frontend and backend are on different domains (not recommended): full URL.
VITE_API_URL=

# Toggle for deposit flow behavior:
# "manual"  → backend records the deposit instantly (dev convenience)
# "mpesa"   → backend triggers STK push (real Daraja flow)
VITE_DEPOSIT_MODE=